{
  "name": "longhorn-ticket-grabber",
  "version": "0.2.0",
  "private": true,
  "description": "Desktop app that spawns and monitors parallel queue sessions to improve odds of getting Longhorn student tickets.",
  "author": "Aayush Baniya <thisisaayushbaniya@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/AayushBaniya2006/longhorn-ticket-grabber.git"
  },
  "dependencies": {
    "electron-is-dev": "^2.0.0",
    "node-window-manager": "^2.2.4",
    "puppeteer": "^24.19.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "homepage": ".",
  "main": "dist/backend/main.js",
  "build": {
    "appId": "com.aayushbaniya.longhornticketgrabber",
    "productName": "Longhorn Ticket Grabber",
    "directories": {
      "output": "release"
    },
    "extraMetadata": {
      "main": "dist/backend/main.js"
    },
    "afterPack": "./scripts/adhoc-sign.js",
    "publish": [
      {
        "provider": "github",
        "owner": "AayushBaniya2006",
        "repo": "longhorn-ticket-grabber"
      }
    ],
    "files": [
      "dist/**/*",
      "build/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "puppeteer-cache",
        "to": "puppeteer-cache"
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "artifactName": "Longhorn-Ticket-Grabber-Mac.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Longhorn-Ticket-Grabber-Windows.${ext}"
    }
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "electron:serve": "tsc --project tsconfig.electron.json && concurrently -k \"cross-env BROWSER=none npm start\" \"wait-on http://127.0.0.1:3000 && electron .\"",
    "electron:build": "tsc --project tsconfig.electron.json",
    "electron": "tsc --project tsconfig.electron.json && wait-on tcp:3000 && electron .",
    "build:all": "npm run build && npm run electron:build",
    "fetch-chromium": "cross-env PUPPETEER_CACHE_DIR=./puppeteer-cache puppeteer browsers install chrome",
    "package": "npm run build:all && npm run fetch-chromium && electron-builder",
    "package:mac": "npm run build:all && npm run fetch-chromium && electron-builder --mac",
    "package:win": "npm run build:all && npm run fetch-chromium && electron-builder --win",
    "test:integration": "node scripts/test-queue-sim.js",
    "test:smoke": "node tests/electron-smoke.js",
    "test:e2e": "node tests/electron-e2e.js"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.60",
    "@types/react": "^18.2.34",
    "@types/react-dom": "^18.2.14",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^27.0.3",
    "electron-builder": "^24.13.3",
    "playwright": "^1.62.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "tailwindcss": "^3.3.5",
    "typescript": "^4.9.5",
    "wait-on": "^7.1.0",
    "web-vitals": "^2.1.4"
  }
}
